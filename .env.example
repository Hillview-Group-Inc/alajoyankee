# ─────────────────────────────────────────────────
# Alajo Yankee · Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ─────────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=3000

# JWT
JWT_SECRET=replace_with_a_long_random_secret_at_least_64_chars
JWT_EXPIRES_IN=7d

# bcrypt
BCRYPT_ROUNDS=12

# SQL Server (Azure / local)
DB_SERVER=your-server.database.windows.net
DB_PORT=1433
DB_NAME=AlajoYankeeDB
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_ENCRYPT=true
DB_TRUST_CERT=false

# CORS — comma-separated allowed origins
CORS_ORIGINS=http://localhost:3000,https://alajoyankee.azurewebsites.net

# Rate limiting (requests per 15 min window)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
